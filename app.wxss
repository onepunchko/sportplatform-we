/**app.wxss**/
page {
  height: 100%;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  background-color: #f5f7fa;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 通用卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 通用文字样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.text-primary {
  color: #3370FF;
}

.text-secondary {
  color: #999;
}

.btn-primary {
  background-color: #3370FF;
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  font-size: 30rpx;
  border: none;
}

.btn-secondary {
  background-color: #f2f5ff;
  color: #3370FF;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  font-size: 30rpx;
  border: none;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.justify-between {
  justify-content: space-between;
}

.align-center {
  align-items: center;
}

.align-start {
  align-items: flex-start;
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.mr-10 {
  margin-right: 10rpx;
} 