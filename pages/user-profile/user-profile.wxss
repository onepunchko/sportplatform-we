.profile-container {
  padding: 40rpx;
  min-height: 100vh;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: column;
}

.profile-header {
  margin-bottom: 60rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.header-desc {
  font-size: 28rpx;
  color: #666;
}

.profile-form {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 头像上传区域 */
.avatar-section {
  margin-bottom: 40rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #eee;
}

.avatar-uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #eee;
  background-color: #f5f5f5;
}

.avatar-tips {
  font-size: 24rpx;
  color: #1890ff;
}

/* 昵称输入区域 */
.nickname-section {
  margin-bottom: 20rpx;
}

.nickname-input-wrap {
  display: flex;
  align-items: center;
  height: 90rpx;
  border-bottom: 1rpx solid #eee;
}

.nickname-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333;
}

/* 提交按钮 */
.submit-section {
  margin-top: auto;
  padding: 20rpx 0;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  background-color: #1890ff;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 45rpx;
}

.submit-btn.disabled {
  background-color: #ccc;
} 