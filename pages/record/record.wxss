/* pages/record/record.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.sport-info {
  padding: 30rpx;
  background-color: #ffffff;
}

.sport-type {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 20rpx;
}

.timer {
  font-size: 60rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
}

.map-container {
  width: 100%;
  height: 40vh;
}

.map {
  width: 100%;
  height: 100%;
}

.stats-container {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  background-color: #ffffff;
  margin-top: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.control-container {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.control-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}

.btn-inner {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.pause-btn {
  background-color: #ff9500;
}

.resume-btn {
  background-color: #34c759;
}

.end-btn {
  background-color: #ff3b30;
} 