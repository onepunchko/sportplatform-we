<!-- pages/record/record.wxml -->
<view class="container">
  <view class="sport-info">
    <view class="sport-type">
      <text>当前运动：{{sportTypeName}}</text>
    </view>
    <view class="timer">{{timerDisplay}}</view>
  </view>

  <view class="map-container">
    <map id="map" class="map" longitude="{{location.longitude}}" latitude="{{location.latitude}}" scale="16" markers="{{markers}}" polyline="{{polyline}}" show-location></map>
  </view>

  <view class="stats-container">
    <view class="stat-item">
      <text class="stat-value">{{distance}}</text>
      <text class="stat-label">距离 (公里)</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{pace}}</text>
      <text class="stat-label">配速 (分钟/公里)</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{calories}}</text>
      <text class="stat-label">消耗 (千卡)</text>
    </view>
  </view>

  <view class="control-container">
    <view class="control-btn pause-btn" wx:if="{{!isPaused}}" bindtap="pauseTracking">
      <view class="btn-inner">暂停</view>
    </view>
    <view class="control-btn resume-btn" wx:if="{{isPaused}}" bindtap="resumeTracking">
      <view class="btn-inner">继续</view>
    </view>
    <view class="control-btn end-btn" bindtap="endTracking">
      <view class="btn-inner">结束</view>
    </view>
  </view>
</view> 