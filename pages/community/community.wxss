/* pages/community/community.wxss */
.container {
  padding: 30rpx;
  padding-bottom: 140rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 15rpx 25rpx;
  margin-right: 20rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
}

.search-icon image {
  width: 100%;
  height: 100%;
}

.search-input input {
  flex: 1;
  height: 70rpx;
  font-size: 28rpx;
  margin-left: 15rpx;
}

.user-scroll {
  margin-bottom: 30rpx;
}

.user-list {
  white-space: nowrap;
  padding: 10rpx 0;
}

.user-item {
  display: inline-block;
  margin-right: 30rpx;
  text-align: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100rpx;
}

.category-scroll {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 15rpx;
}

.category-list {
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  margin-right: 30rpx;
  padding: 10rpx 0;
  font-size: 28rpx;
  position: relative;
}

.category-item.active {
  font-weight: bold;
  color: #3370FF;
}

.category-item.active:after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #3370FF;
  border-radius: 2rpx;
}

.post-list {
  margin-top: 20rpx;
}

.card {
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.post-item {
  
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
}

.post-avatar image {
  width: 100%;
  height: 100%;
}

.post-user-info {
  flex: 1;
}

.post-username {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-content {
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 15rpx;
}

.post-images image {
  width: 210rpx;
  height: 210rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
}

.post-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-item image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.action-item text {
  font-size: 24rpx;
  color: #666;
}

.post-input-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
}

.post-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  margin-right: 20rpx;
}

.post-input {
  flex: 1;
  height: 70rpx;
  font-size: 28rpx;
}

.post-input-actions {
  display: flex;
}

.input-action {
  padding: 10rpx;
}

.input-action image {
  width: 40rpx;
  height: 40rpx;
}

.post-button {
  padding: 0 30rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #3370FF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 35rpx;
}

.add-post-button {
  position: fixed;
  bottom: 120rpx;
  right: 30rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #3370FF;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(51, 112, 255, 0.3);
}

.add-post-button image {
  width: 50rpx;
  height: 50rpx;
}

/* 分类标签样式 */
.post-category-labels {
  margin: 10rpx 0 0 0;
}

.category-label {
  display: inline-block;
  background: #f0f4ff;
  color: #3370FF;
  font-size: 22rpx;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 4rpx;
}

/* 评论区样式 */
.comment-list {
  background: #f8f8f8;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-top: 10rpx;
}

.comment-item {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #333;
}

.comment-user {
  color: #3370FF;
  font-weight: bold;
}

.comment-content {
  margin-left: 8rpx;
}

.comment-input-wrapper {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.comment-input {
  flex: 1;
  height: 60rpx;
  border-radius: 30rpx;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.comment-submit {
  margin-left: 16rpx;
  background: #3370FF;
  color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
} 