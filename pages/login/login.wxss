.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  margin-bottom: 80rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.auth-area {
  width: 100%;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 40rpx;
}

.auth-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}

.auth-item:last-child {
  border-bottom: none;
}

.auth-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.auth-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.auth-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.wx-btn {
  background-color: #07c160;
  color: #fff;
}

.phone-btn {
  background-color: #1890ff;
  color: #fff;
}

.privacy-policy {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 30rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.policy-links {
  color: #1890ff;
  margin-left: 5rpx;
}

.auth-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.success-text {
  font-size: 30rpx;
  color: #333;
  margin-top: 20rpx;
}

.reject-guide {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.reject-guide > view {
  background-color: #fff;
  border-radius: 16rpx;
  width: 80%;
  padding: 30rpx;
}

.guide-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
}

.guide-content {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 30rpx;
}

.guide-btns {
  display: flex;
  justify-content: space-between;
}

.guide-btns button {
  width: 45%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background-color: #1890ff;
  color: #fff;
} 