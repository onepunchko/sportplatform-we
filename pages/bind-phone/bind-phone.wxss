/* 绑定手机号页面样式 */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 页面头部 */
.header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.header-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  max-width: 80%;
}

/* 表单区域 */
.form {
  width: 100%;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 30rpx;
  position: relative;
}

.icon-wrapper {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.phone-input, .code-input {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.clear-btn image {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.5;
}

.code-item {
  display: flex;
  align-items: center;
}

.code-btn {
  min-width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  border-radius: 35rpx;
  background-color: #1890ff;
  color: #fff;
  padding: 0 20rpx;
  margin-left: 20rpx;
  margin-right: 0;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.code-btn.disabled {
  background-color: #ccc;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 60rpx;
}

.submit-btn[disabled] {
  background-color: #ccc;
  color: #fff;
}

/* 其他绑定方式 */
.alternative {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0 40rpx;
}

.alt-text {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
  position: relative;
}

.alt-text::before,
.alt-text::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 60rpx;
  height: 1rpx;
  background-color: #ddd;
}

.alt-text::before {
  left: -80rpx;
}

.alt-text::after {
  right: -80rpx;
}

.alt-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  background-color: #f4f4f4;
  border: 1rpx solid #eee;
}

.alt-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.alt-btn text {
  font-size: 28rpx;
  color: #333;
}

/* 提示信息 */
.tips {
  width: 100%;
  padding: 30rpx;
  border-radius: 12rpx;
  background-color: #f0f8ff;
  margin-top: auto;
  margin-bottom: 30rpx;
}

.tips-title {
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

/* 错误提示框 */
.error-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.error-content {
  width: 80%;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-title {
  width: 100%;
  padding: 30rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.error-message {
  padding: 40rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  text-align: center;
}

.error-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  color: #1890ff;
  border-top: 1rpx solid #eee;
  border-radius: 0;
  background-color: #fff;
} 