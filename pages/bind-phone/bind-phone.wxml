<view class="container">
  <view class="title">绑定手机号</view>
  <view class="subtitle">绑定手机号可以体验完整功能</view>
  
  <view class="form">
    <view class="form-item">
      <input type="number" placeholder="请输入手机号" bindinput="onPhoneInput" value="{{phone}}" />
    </view>
    
    <view class="form-item code-item">
      <view class="icon-wrapper">
        <image class="icon" src="/static/images/verify_code.png" mode="aspectFit"></image>
      </view>
      <input class="code-input" type="number" maxlength="4" placeholder="请输入验证码" bindinput="onCodeInput" value="{{code}}" />
      <button class="code-btn {{codeSent ? 'disabled' : ''}}" bindtap="sendCode" disabled="{{codeSent || !phone || phone.length != 11}}">
        {{codeSent ? countdown + 's' : '获取验证码'}}
      </button>
    </view>
    
    <button class="submit-btn" bindtap="bindPhone" disabled="{{!phone || phone.length != 11 || !code || code.length != 4}}">
      确认绑定
    </button>
  </view>
  
  <view class="tips">
    <view class="tips-title">温馨提示：</view>
    <view class="tips-item">• 请确保输入的手机号真实有效</view>
    <view class="tips-item">• 验证码：0628</view>
    <view class="tips-item">• 绑定手机号后可参与各项活动和服务</view>
    <view class="tips-item">• 我们将严格保护您的个人信息安全</view>
  </view>
  
  <!-- 错误提示框 -->
  <view class="error-modal" wx:if="{{showError}}">
    <view class="error-content">
      <view class="error-title">提示</view>
      <view class="error-message">{{errorMessage}}</view>
      <button class="error-btn" bindtap="closeError">知道了</button>
    </view>
  </view>
</view> 