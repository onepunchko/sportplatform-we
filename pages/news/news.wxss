/* pages/news/news.wxss */
.container {
  padding: 20rpx 30rpx;
  background-color: #f8f8f8;
}

/* 头部搜索栏 */
.header {
  margin-bottom: 20rpx;
}

.search-box {
  position: relative;
  height: 70rpx;
}

.search-input {
  width: 100%;
  height: 100%;
  padding: 0 70rpx 0 30rpx;
  border-radius: 35rpx;
  background-color: #f0f0f0;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
}

/* 分类标签栏 */
.category-tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: #fff;
  margin: 0 -30rpx;
  padding: 0 30rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs {
  display: flex;
  height: 80rpx;
}

.tab-item {
  padding: 0 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #999;
  position: relative;
  display: inline-block;
}

.tab-item.active {
  color: #007aff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #007aff;
  border-radius: 3rpx;
}

/* 资讯列表 */
.news-container {
  margin-top: 20rpx;
}

.news-item {
  padding: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.news-image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.news-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.news-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
  font-size: 24rpx;
  color: #999;
}

.news-summary {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-author {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.author-name {
  font-size: 24rpx;
  color: #666;
}

.news-actions {
  display: flex;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}

.action-btn image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.action-btn text {
  font-size: 24rpx;
  color: #999;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 30rpx 0;
}

/* 推荐文章 */
.recommended-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.recommended-item {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.recommended-image {
  width: 100%;
  height: 300rpx;
}

.recommended-content {
  padding: 20rpx;
}

.recommended-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.recommended-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
} 