# 环境配置
FLASK_ENV=production

# 安全配置 - 生产环境应使用强密钥
SECRET_KEY=production_very_secure_key_should_be_changed
JWT_SECRET_KEY=production_very_secure_jwt_key_should_be_changed

# 数据库配置 - 生产环境数据库
DATABASE_URL=mysql+pymysql://prod_user:strong_password@db.example.com/sport_platform_prod

# 应用配置
DEBUG=False
HOST=0.0.0.0
PORT=5000

# 跨域配置 - 只允许实际域名
CORS_ORIGINS=https://www.example.com,https://admin.example.com

# 文件上传配置
UPLOAD_FOLDER=/var/www/uploads
MAX_CONTENT_LENGTH=8388608

# 微信小程序配置 - 生产环境正式参数
WX_APP_ID=wx1234567890abcdef
WX_APP_SECRET=86fc371aee671da8c9222a18fee85076 